{
  "schema": 1,
  "file": "synthetic_face.json",
  "settings": [
    { "key": "DriveMouth", "type": "bool", "label": "Drive mouth from voice", "default": true },
    { "key": "DriveEmotion", "type": "bool", "label": "Expression from vocal tone", "default": true },
    { "key": "DriveEyes", "type": "bool", "label": "Procedural eyes", "default": true },
    { "key": "QualityMode", "type": "bool", "label": "Model-based emotion (needs a model file)", "default": false },
    { "key": "MouthIntensity", "type": "float", "label": "Mouth intensity", "min": 0.0, "max": 2.0, "default": 0.6 },
    { "key": "EmotionIntensity", "type": "float", "label": "Expression intensity", "min": 0.0, "max": 2.0, "default": 1.0 },
    { "key": "IdleIntensity", "type": "float", "label": "Idle micro-motion", "min": 0.0, "max": 1.0, "default": 1.0 },
    { "key": "QuestionEnabled", "type": "bool", "label": "Question brow raise", "default": true },
    { "key": "QuestionGain", "type": "float", "label": "Question gain", "min": 0.0, "max": 2.0, "default": 1.0 },
    { "key": "EmphasisEnabled", "type": "bool", "label": "Emphasis brow flash", "default": true },
    { "key": "EmphasisGain", "type": "float", "label": "Emphasis gain", "min": 0.0, "max": 2.0, "default": 1.0 },
    { "key": "EngagementEnabled", "type": "bool", "label": "Engagement eye widen", "default": true },
    { "key": "EngagementGain", "type": "float", "label": "Engagement gain", "min": 0.0, "max": 2.0, "default": 1.0 },
    { "key": "HesitationEnabled", "type": "bool", "label": "Hesitation brow furrow", "default": true },
    { "key": "HesitationGain", "type": "float", "label": "Hesitation gain", "min": 0.0, "max": 2.0, "default": 1.0 },
    { "key": "LaughterEnabled", "type": "bool", "label": "Laughter smile", "default": true },
    { "key": "LaughterGain", "type": "float", "label": "Laughter gain", "min": 0.0, "max": 2.0, "default": 1.0 },
    { "key": "MicDeviceNumber", "type": "int", "label": "Mic device index (-1 = default)", "min": -1, "max": 63, "default": -1 },
    { "key": "MicDeviceName", "type": "string", "label": "Mic device name match", "default": "" }
  ]
}
