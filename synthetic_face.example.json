{
  // Microphone-driven mouth shapes (lip-sync). Turn off to stop driving the mouth.
  "DriveMouth": true,

  // Subtle arousal-driven expression coloring on brows and eyes, plus the episodic smile. Low
  // intensity by design; it never overrides the lip-sync mouth shapes.
  "DriveEmotion": true,

  // Procedural blink + gaze. OFF by default so VRChat's own idle blink/auto-gaze runs. Turn on to
  // drive the avatar's eye parameters from this module instead.
  "DriveEyes": false,

  // Quality tier: run a local ONNX speech-emotion model for a better arousal estimate (requires
  // EmotionModelPath). Heavier (CPU only); off by default. With no model present it transparently
  // falls back to the always-on heuristic.
  "QualityMode": false,

  // Scales the emotion coloring amount: 0 disables it, 1 uses the full (already conservative) caps.
  "EmotionIntensity": 1.0,

  // Scales the episodic smile on the mouth corners (timings from real tracker recordings).
  // Audio cannot tell when you are smiling, so this defaults to 0 and the corners stay still.
  // Set to 1 to let smile episodes play while you talk.
  "SmileIntensity": 0.0,

  // Scales the mouth output amount. 0.6 matches tracked jaw travel; 1 is the raw solver level.
  "MouthIntensity": 0.6,

  // Scales the always-on idle micro-motion (small brow/squint events while quiet).
  // 0 disables it; 1 matches rates and amplitudes measured from real tracker recordings.
  "IdleIntensity": 1.0,

  // Capture device index; -1 selects the system default capture device.
  "MicDeviceNumber": -1,

  // Optional: prefer the first capture device whose name contains this text (case-insensitive).
  // Overrides MicDeviceNumber when a match is found.
  "MicDeviceName": null,

  // Optional: path to a license-clean ONNX speech-emotion model used when QualityMode is on.
  "EmotionModelPath": null
}
