{
  // Microphone-driven mouth shapes (lip-sync). Turn off to stop driving the mouth.
  "DriveMouth": true,

  // Expression from vocal tone: question, emphasis, engagement, hesitation and laughter episodes on
  // brows, eyes and mouth corners. Never overrides the lip-sync mouth shapes.
  "DriveEmotion": true,

  // Procedural blink + gaze, timed to tracked-eye recordings. Turn off to keep VRChat's own idle
  // blink/auto-gaze instead.
  "DriveEyes": true,

  // Quality tier: run a local ONNX speech-emotion model for a better arousal estimate (requires
  // EmotionModelPath). Heavier (CPU only); off by default. With no model present it transparently
  // falls back to the always-on heuristic.
  "QualityMode": false,

  // Master gain over every tone-driven episode: 0 disables them, 1 matches tracked amplitudes.
  "EmotionIntensity": 1.0,

  // Per-channel switch and gain. Gains multiply EmotionIntensity; 1 matches tracked amplitudes.
  "QuestionEnabled": true,
  "QuestionGain": 1.0,
  "EmphasisEnabled": true,
  "EmphasisGain": 1.0,
  "EngagementEnabled": true,
  "EngagementGain": 1.0,
  "HesitationEnabled": true,
  "HesitationGain": 1.0,
  "LaughterEnabled": true,
  "LaughterGain": 1.0,

  // Scales the mouth output amount. 0.4 matches tracked jaw travel; 1 is the raw solver level.
  "MouthIntensity": 0.4,

  // Spontaneous blink rate. 15.9 is the pooled rate measured from tracked sessions; gaze shifts and
  // vocal arousal still modulate it around this figure.
  "BlinkRatePerMinute": 15.9,

  // Scales the always-on idle micro-motion (small brow/squint events while quiet).
  // 0 disables it; 1 matches rates and amplitudes measured from real tracker recordings.
  "IdleIntensity": 1.0,

  // How strongly the eyes counter-rotate against head movement so gaze holds still while the head
  // turns. 0 turns head coupling off entirely. Needs a headset; ignored when there is no pose.
  "VorGain": 0.95,

  // How long the eyes take to drift back to centre once the head stops turning.
  "VorRecenterSeconds": 0.3,

  // Head speed, in radians per second, above which idle saccades pause: a turning head already
  // carries the gaze shift, so firing extra saccades on top reads as jitter.
  "HeadMovingThreshold": 0.5,

  // Hold the listener's face more while quiet than while speaking, and glance away at the start of
  // an utterance, the way people actually trade turns.
  "SocialGazeEnabled": true,

  // Left/right imbalance in expressions: one side leads slightly and runs a little stronger.
  // 0 restores a perfectly even face.
  "AsymmetryIntensity": 1.0,

  // Let the eyes close after a long stretch of a motionless, silent head. Needs a headset: with no
  // pose the eyes never close on their own, whatever the microphone hears.
  "DozeEnabled": true,

  // How long the head must stay motionless and quiet before the lids start to fall.
  "DozeDwellSeconds": 45.0,

  // Further dozing before the eyes go to nearly shut.
  "SleepDwellSeconds": 60.0,

  // Averaged head speed below which the head counts as motionless. Wearing a headset keeps the head
  // moving, so real stillness means the wearer has stopped. Raise it if the eyes never close, lower
  // it if they close while you are still awake. Where the head points is deliberately ignored.
  "DozeStillnessRadPerSecond": 0.06,

  // Capture device index; -1 selects the system default capture device.
  "MicDeviceNumber": -1,

  // Optional: prefer the first capture device whose name contains this text (case-insensitive).
  // Overrides MicDeviceNumber when a match is found.
  "MicDeviceName": null,

  // Optional: path to a license-clean ONNX speech-emotion model used when QualityMode is on.
  "EmotionModelPath": null
}
